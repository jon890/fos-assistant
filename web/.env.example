# Google OAuth 클라이언트
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# NextAuth 세션 암호화 키
AUTH_SECRET=
# Control Plane 과 공유하는 HMAC 비밀값. 백엔드의 ASSISTANT_JWT_SECRET 과 같아야 한다
ASSISTANT_JWT_SECRET=
# 사이드바 머리, 로그인 화면, 브라우저 제목에 보일 앱 이름. 실행할 때 읽는다. 비우면 fos-assistant
APP_NAME=
# Control Plane 주소
CONTROL_PLANE_BASE_URL=http://localhost:8080

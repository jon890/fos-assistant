# Google OAuth 클라이언트
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# NextAuth 세션 암호화 키
AUTH_SECRET=
# 로그인을 허용할 가족 구성원 메일 주소를 쉼표로 구분해 적는다
ASSISTANT_ALLOWED_EMAILS=
# Control Plane 과 공유하는 HMAC 비밀값. 백엔드의 ASSISTANT_JWT_SECRET 과 같아야 한다
ASSISTANT_JWT_SECRET=
# Control Plane 주소
CONTROL_PLANE_BASE_URL=http://localhost:8080

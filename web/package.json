{
  "name": "fos-assistant-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format:check": "files=$(node scripts/changed-files.mjs) && { [ -z \"$files\" ] || printf '%s\\n' \"$files\" | xargs prettier --check; }",
    "format:changed": "files=$(node scripts/changed-files.mjs) && { [ -z \"$files\" ] || printf '%s\\n' \"$files\" | xargs prettier --write; }",
    "test:browser": "playwright test --config ../test/browser/playwright.config.ts",
    "screenshots": "playwright test --config ../test/screenshots/playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.48.0",
    "next": "16.0.10",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.0.10",
    "prettier": "3.9.9",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}

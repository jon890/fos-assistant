{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    // @types/node 는 web 의 devDependencies 에 있다. test 는 별도 설치 없이 그것을 빌려 쓴다
    "typeRoots": ["../web/node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["e2e/**/*.ts", "model-eval/**/*.ts"],
  // 단위 테스트는 node --test 가 직접 읽는다. 저장소 규칙 테스트(repo)도 이 검사에 들지 않는다
  "exclude": ["e2e/unit", "model-eval/**/*.test.ts"]
}

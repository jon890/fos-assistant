{
  "schema": 2,
  "id": "naver-blog",
  "title": "네이버 블로그",
  "description": "「내 브라우저」 에 로그인해 둔 네이버 계정의 임시저장 글을 읽고 고치며, 승인한 글을 임시저장합니다. 발행하지 않습니다.",
  "icon": "icon.svg",
  "link": "https://blog.naver.com/",
  "fields": [
    {
      "key": "blog_id",
      "env": "NAVER_BLOG_ID",
      "label": "블로그 아이디",
      "description": "blog.naver.com/<아이디> 의 아이디입니다.",
      "secret": false,
      "required": true,
      "pattern": "^[A-Za-z0-9_-]{1,50}$"
    }
  ],
  "verify": { "tool": "session_status" },
  "owner_attachments_env": "NAVER_BLOG_ATTACHMENT_DIR",
  "owner_browser_env": "NAVER_BLOG_BROWSER_URL",
  "owner_browser_login_url": "https://nid.naver.com/nidlogin.login",
  "default_tool_policy": "deny",
  "tools": {
    "session_status": { "risk": "READ" },
    "list_drafts": { "risk": "READ" },
    "read_draft": { "risk": "WRITE", "approval": "required", "grant": false, "title": "네이버 임시저장 글 불러오기 · 자동저장 가능", "outbound": false },
    "render_draft": { "risk": "READ" },
    "save_draft": { "risk": "WRITE", "title": "네이버 블로그에 임시저장", "outbound": false },
    "overwrite_draft": { "risk": "WRITE", "title": "네이버 블로그 임시저장 글 덮어쓰기", "outbound": false, "grant": false },
    "draft_job": { "risk": "READ" }
  },
  "errors": {
    "NAVER_BLOG_INVALID_INPUT": "invalid_input",
    "NAVER_BLOG_PHOTO_INVALID": "invalid_input",
    "NAVER_BLOG_LOGIN_REQUIRED": "credential_rejected",
    "NAVER_BLOG_BROWSER_UNREACHABLE": "unavailable",
    "NAVER_BLOG_BUSY": "unavailable",
    "NAVER_BLOG_JOB_NOT_FOUND": "invalid_input",
    "NAVER_BLOG_DRAFT_NOT_FOUND": "invalid_input",
    "NAVER_BLOG_EDITOR_IN_USE": "unavailable",
    "NAVER_BLOG_START_UNKNOWN": "outcome_unknown",
    "NAVER_BLOG_UNAVAILABLE": "unavailable"
  }
}

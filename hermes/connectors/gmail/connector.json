{
  "schema": 2,
  "id": "gmail",
  "title": "Gmail",
  "description": "Gmail 의 메일과 라벨, 필터를 읽고 승인한 초안, 메일, 라벨과 필터를 만듭니다.",
  "icon": "icon.svg",
  "link": "https://mail.google.com/",
  "fields": [
    { "key": "client_id", "env": "GMAIL_OAUTH_CLIENT_ID", "label": "OAuth 클라이언트 ID",
      "description": "Google Cloud 콘솔의 「사용자 인증 정보」 에서 만든 데스크톱 앱 클라이언트의 ID 입니다.",
      "secret": false, "required": true,
      "pattern": "^[0-9A-Za-z_-]+\\.apps\\.googleusercontent\\.com$" },
    { "key": "client_secret", "env": "GMAIL_OAUTH_CLIENT_SECRET", "label": "OAuth 클라이언트 secret",
      "description": "같은 클라이언트의 보안 비밀번호입니다. Google Cloud 콘솔에서 봅니다.",
      "secret": true, "required": true },
    { "key": "refresh_token", "env": "GMAIL_OAUTH_REFRESH_TOKEN", "label": "refresh token",
      "description": "설정 안내의 스크립트를 자기 컴퓨터에서 돌려 받은 값입니다.",
      "secret": true, "required": true }
  ],
  "verify": { "tool": "get_profile" },
  "default_tool_policy": "deny",
  "tools": {
    "get_profile": { "risk": "READ" },
    "list_labels": { "risk": "READ" },
    "search_messages": { "risk": "READ" },
    "get_message": { "risk": "READ" },
    "get_thread": { "risk": "READ" },
    "create_draft": { "risk": "WRITE", "title": "초안 만들기", "outbound": false,
      "identifiers": ["reply_to_message_id"] },
    "modify_labels": { "risk": "WRITE", "title": "라벨 바꾸기", "grant": false, "outbound": false,
      "identifiers": ["message_id"] },
    "send_message": { "risk": "WRITE", "title": "메일 보내기", "grant": false, "outbound": true },
    "reply_to_message": { "risk": "WRITE", "title": "답장 보내기", "grant": false, "outbound": true,
      "identifiers": ["message_id"] },
    "create_label": { "risk": "WRITE", "title": "라벨 만들기", "outbound": false },
    "update_label": { "risk": "WRITE", "title": "라벨 설정 바꾸기", "outbound": false,
      "identifiers": ["label"] },
    "list_filters": { "risk": "READ" },
    "create_filter": { "risk": "WRITE", "title": "필터 만들기", "grant": false, "outbound": false },
    "delete_filter": { "risk": "WRITE", "title": "필터 지우기", "grant": false, "outbound": false,
      "identifiers": ["filter_id"] },
    "apply_labels_to_query": { "risk": "WRITE", "title": "검색한 메일의 라벨 바꾸기", "grant": false, "outbound": false }
  },
  "errors": {
    "GMAIL_UNAUTHORIZED": { "category": "credential_rejected", "recovery": "reconnect" },
    "GMAIL_FORBIDDEN": "forbidden",
    "GMAIL_FILTER_SCOPE_REQUIRED": { "category": "forbidden", "recovery": "reconnect" },
    "GMAIL_INVALID_INPUT": { "category": "invalid_input", "recovery": "fix_input" },
    "GMAIL_TARGET_COUNT_CHANGED": { "category": "invalid_input", "recovery": "recheck",
      "details": ["actual_count"] },
    "GMAIL_SEND_UNKNOWN": "outcome_unknown",
    "GMAIL_UNAVAILABLE": { "category": "unavailable", "recovery": "retry_later" }
  }
}

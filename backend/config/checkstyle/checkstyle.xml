<?xml version="1.0" encoding="UTF-8"?>
<!-- 코드 규칙: rule-32, rule-33, rule-34, rule-35, rule-36, rule-37, rule-38, rule-39, rule-40, rule-41, rule-42. 까닭과 예외는 docs/code-rules/INDEX.md를 본다. -->

<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  백엔드 코드 규칙이다. Gradle 의 checkstyleMain, checkstyleTest 가 읽는다.
  넣은 규칙의 까닭과 예외는 docs/code-rules가 갖고 실행 조건은 이 파일이 갖는다. 뺀 규칙의 까닭과 기준 파일 갱신 방법은 backend/docs/code-architecture.md 에 있다.

  파일 셋
  - checkstyle.xml  이 파일. 규칙을 둔다
  - suppressions.xml  설계상 예외. 앞으로도 허용하는 것이다
  - baseline.xml  기존 위반. (파일, 규칙) 단위로 줄여 가는 목록이다

  severity 가 warning 인 규칙은 빌드를 실패시키지 않고 보고서에만 남긴다.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- 설계상 예외 -->
  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/suppressions.xml"/>
    <property name="optional" value="false"/>
  </module>
  <!-- 기존 위반 -->
  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/baseline.xml"/>
    <property name="optional" value="false"/>
  </module>

  <!-- rule-32: 까닭과 예외는 docs/code-rules/rule-32.md를 본다 -->
  <module name="RegexpMultiline">
    <property name="id" value="privateEmptyConstructor"/>
    <property name="format" value="private\s+[A-Z]\w*\s*\(\s*\)\s*\{\s*\}"/>
    <property name="message" value="[privateEmptyConstructor] 빈 private 생성자를 직접 쓰지 말고 @NoArgsConstructor(access = AccessLevel.PRIVATE) 로 쓴다"/>
  </module>

  <!-- rule-33: 까닭과 예외는 docs/code-rules/rule-33.md를 본다 -->
  <module name="RegexpMultiline">
    <property name="id" value="entityHandwrittenAccessor"/>
    <property name="format" value="\A(?=[\s\S]*@Entity\b)(?=[\s\S]*public\s+[\w&lt;&gt;\[\], ?.]+\s+\w+\s*\(\s*\)\s*\{\s*return\s+(?:this\s*\.\s*)?\w+\s*;\s*\})[\s\S]"/>
    <property name="message" value="[entityHandwrittenAccessor] 엔티티의 접근자를 손으로 쓰지 말고 @Getter 와 @Accessors(fluent = true) 로 만든다"/>
  </module>

  <!-- rule-34: 까닭과 예외는 docs/code-rules/rule-34.md를 본다 -->
  <module name="RegexpMultiline">
    <property name="id" value="requiredArgsConstructor"/>
    <property name="severity" value="warning"/>
    <property name="format" value="(?m)\A(?![\s\S]*@RequiredArgsConstructor)(?=[\s\S]*^@(?:Service|Component|Repository|RestController|Controller|Configuration)\b)(?=[\s\S]*?\b(?:class|enum)\s+(\w+)\b[\s\S]*?^[ \t]*(?:public\s+|protected\s+|private\s+)?\1\s*\(\s*[^)\s])[\s\S]"/>
    <property name="message" value="[requiredArgsConstructor] 인자가 있는 생성자를 직접 쓰지 말고 @RequiredArgsConstructor 를 쓴다"/>
  </module>

  <module name="TreeWalker">
    <!-- rule-35: 까닭과 예외는 docs/code-rules/rule-35.md를 본다 -->
    <module name="SuppressWithNearbyCommentFilter">
      <property name="commentFormat" value="전체 이름 허용:"/>
      <property name="idFormat" value="fullyQualifiedName"/>
      <property name="influenceFormat" value="0"/>
    </module>

    <!-- rule-35: 까닭과 예외는 docs/code-rules/rule-35.md를 본다 -->
    <module name="UnusedImports"/>
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="IllegalImport"/>

    <!-- 코드 안에서는 전체 이름을 쓰지 않고 import 한다. import, package 줄과 문자열 안의 글은 뺀다 -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="fullyQualifiedName"/>
      <property name="format" value="^(?!\s*(?:import|package)\s)(?:[^&quot;\\]|\\.|&quot;(?:[^&quot;\\]|\\.)*&quot;)*?(?&lt;![\w.])(?:java|javax|jakarta|org|com|io|tools|lombok)\.(?:[a-z_][a-z0-9_]*\.)+[A-Z]"/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="[fullyQualifiedName] 전체 이름을 쓰지 말고 import 한다. 같은 이름의 두 타입 때문에 어려우면 그 줄에 '// 전체 이름 허용: 까닭' 을 단다"/>
    </module>

    <!-- rule-36: 까닭과 예외는 docs/code-rules/rule-36.md를 본다 -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="lombokLogger"/>
      <property name="format" value="^\s*(?:(?:private|protected|public|static|final)\s+)*(?:org\.slf4j\.)?Logger\s+\w+\s*=\s*(?:org\.slf4j\.)?LoggerFactory\s*\.\s*getLogger"/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="[lombokLogger] 로거를 직접 만들지 말고 @Slf4j 를 쓴다"/>
    </module>

    <!-- rule-37: 까닭과 예외는 docs/code-rules/rule-37.md를 본다 -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="^(ignored|expected)$"/>
    </module>

    <!-- rule-38: 까닭과 예외는 docs/code-rules/rule-38.md를 본다 -->
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="StringLiteralEquality"/>
    <module name="FallThrough"/>
    <module name="MissingOverride"/>

    <!-- rule-39: 까닭과 예외는 docs/code-rules/rule-39.md를 본다 -->
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="ModifierOrder"/>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>

    <!-- rule-40: 까닭과 예외는 docs/code-rules/rule-40.md를 본다 -->
    <module name="PackageName"/>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="LocalFinalVariableName"/>
    <module name="StaticVariableName"/>
    <module name="LambdaParameterName"/>
    <module name="RecordComponentName"/>
    <module name="ClassTypeParameterName"/>
    <module name="MethodTypeParameterName"/>
    <!-- 로거 이름 log 는 Lombok @Slf4j 가 만드는 이름이다 -->
    <module name="ConstantName">
      <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
    </module>

    <!-- rule-41: 까닭과 예외는 docs/code-rules/rule-41.md를 본다 -->
    <!-- 메서드와 생성자 사이에 빈 줄이 한 줄 이상 있어야 읽는 단위가 보인다. 인터페이스의 추상 메서드 선언 사이도 잡는다 -->
    <module name="EmptyLineSeparator">
      <property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
      <property name="allowMultipleEmptyLines" value="true"/>
    </module>
    <!-- 한 줄에 한 문장 -->
    <module name="OneStatementPerLine"/>
    <!-- 한 줄 람다 본문 '-> { throw ...; }' 은 시험 대역에서 흔한 모양이라 LAMBDA 는 대상에서 뺀다 -->
    <module name="LeftCurly">
      <property name="option" value="eol"/>
      <property name="tokens" value="ANNOTATION_DEF, CLASS_DEF, CTOR_DEF, ENUM_CONSTANT_DEF, ENUM_DEF, INTERFACE_DEF, LITERAL_CASE, LITERAL_CATCH, LITERAL_DEFAULT, LITERAL_DO, LITERAL_ELSE, LITERAL_FINALLY, LITERAL_FOR, LITERAL_IF, LITERAL_SWITCH, LITERAL_SYNCHRONIZED, LITERAL_TRY, LITERAL_WHILE, METHOD_DEF, OBJBLOCK, STATIC_INIT, RECORD_DEF, COMPACT_CTOR_DEF"/>
    </module>
    <!--
      닫는 중괄호를 자기 줄에 두는 자리. 제어문에 alone 계열을 걸면 '} else {' 가 위반이 되어 포매터와 어긋난다.
      alone_or_singleline 을 쓰는 까닭: 포매터가 빈 본문을 'private X() {}' 처럼 한 줄에 쓰므로 alone 은 포매터와 어긋난다.
      한 줄 본문 '{ return x; }' 은 여는 중괄호를 보는 LeftCurly(eol) 가 잡는다.
    -->
    <module name="RightCurly">
      <property name="id" value="rightCurlyAlone"/>
      <property name="option" value="alone_or_singleline"/>
      <property name="tokens" value="METHOD_DEF, CTOR_DEF, CLASS_DEF, LITERAL_FOR, LITERAL_WHILE, STATIC_INIT, INSTANCE_INIT"/>
    </module>
    <module name="RightCurly">
      <property name="id" value="rightCurlySame"/>
      <property name="option" value="same"/>
      <property name="tokens" value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_DO"/>
    </module>
    <!-- 제어문은 한 문장이어도 중괄호를 쓴다 -->
    <module name="NeedBraces"/>

    <!-- rule-42: 까닭과 예외는 docs/code-rules/rule-42.md를 본다 -->
    <module name="MethodLength">
      <property name="max" value="60"/>
      <property name="countEmpty" value="false"/>
      <property name="severity" value="warning"/>
    </module>
  </module>
</module>
